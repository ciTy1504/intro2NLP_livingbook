# ---- secrets: never commit ----
secrets/
*.key
*.pem
.env
.env.*
!.env.example
**/gemini_keypool.txt
**/keypool*.txt
**/API_key.txt
*service-account*.json

# ---- runtime state / data ----
state/*.db
state/*.db-wal
state/*.db-shm
state/*.json
# Pipeline artifacts are runtime evidence, not source. They are reproducible from the
# database and can be large; the provenance that matters is committed in changelog/.
state/artifacts/
logs/*.jsonl
logs/*.log
.build/
research/inbox/*
research/processed/*
research/monitoring/*
research/rejected/*
!research/**/.gitkeep

# candidate + generated figures are working artifacts;
# only figures promoted into manuscript/images/ are committed
figures/candidates/*
figures/generated/*
!figures/**/.gitkeep

knowledge/exports/*
!knowledge/exports/.gitkeep

# ---- LaTeX build artifacts ----
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.synctex.gz
*.toc
_minted*/
*.minted
manuscript/main.pdf

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# generated snapshot; rebuild with `livingbook dashboard`
dashboard/index.html
