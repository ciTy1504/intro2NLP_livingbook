# Copy to secrets/.env and fill in. secrets/ is gitignored in its entirety.
# Nothing in this file is read from the repository at runtime.

# ── Gemini ───────────────────────────────────────────────────────────────────
# Path to the key pool file (one key per line, '#' comments allowed, BOM tolerated).
# Defaults to secrets/gemini_keypool.txt, which is already populated.
GEMINI_KEYPOOL_PATH=secrets/gemini_keypool.txt
# Optional: extra keys inline, comma-separated. Merged with the pool file.
GEMINI_API_KEYS=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Fine-grained PAT with Contents: read/write and Pull requests: read/write
# on ciTy1504/intro2NLP_livingbook. Required for push and PR creation.
# Also lifts the GitHub research API from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# ── Email (Gmail + App Password, per the EngChi pattern) ─────────────────────
GMAIL_USER=
GMAIL_PASS=
EMAIL_RECIPIENTS=bong1552004@gmail.com

# ── Optional research APIs (the system degrades gracefully without them) ─────
# Semantic Scholar returns 429 unauthenticated; a key enables that source.
SEMANTIC_SCHOLAR_API_KEY=
# Any one of these replaces the DuckDuckGo HTML scrape with a real search API.
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# ── Contact address used for polite-pool headers (OpenAlex, Crossref, Unpaywall)
CONTACT_EMAIL=rndvcs@gmail.com
